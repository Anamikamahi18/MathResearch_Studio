      <data key="d0">paper_math_001_theorem_thm_001</data>
      <data key="d1">theorem</data>
      <data key="d2">Theorem 3.2</data>
      <data key="d3">Theorem 3.2 follows from Lemma 2.1. Every continuous map f on a compact metric space has a fixed point.</data>
      <data key="d4">On Compact Topological Spaces and Fixed Point Theorems</data>
      <data key="d5">s2</data>
      <data key="d6">2. Main Results</data>
