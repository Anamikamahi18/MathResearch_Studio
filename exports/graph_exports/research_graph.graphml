      <data key="d0">paper_math_001_definition_def_001</data>
      <data key="d1">definition</data>
      <data key="d2">Definition 1.1</data>
      <data key="d3">A topological space X is compact if every open cover has a finite subcover.</data>
      <data key="d4">On Compact Topological Spaces and Fixed Point Theorems</data>
      <data key="d5">s1</data>
