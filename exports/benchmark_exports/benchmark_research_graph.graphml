    <node id="paper_bm06_differential_equations_definition_def_001">
      <data key="d0">paper_bm06_differential_equations_definition_def_001</data>
      <data key="d1">definition</data>
      <data key="d2">Definition 1.6</data>
      <data key="d3">A function u in L^2(Omega) has weak derivative v = d^alpha u if integral u D^alpha phi = (-1)^{|alpha|} integral v phi for all smooth test functions phi.</data>
      <data key="d4">Global Existence of Weak Solutions for Non-Linear Partial Differential Equations</data>
      <data key="d5">s1</data>
      <data key="d6">1. Function Spaces and Weak Derivatives</data>
